# NEXUS Core — root ignore rules (shared concerns for FRONTEND + BACKEND).
# Git combines this file with FRONTEND/.gitignore and BACKEND/.gitignore;
# on conflicts, rules in the deeper (nested) file win. Nested files are left
# intact except for `!.env.example` additions so templates stay committable.
# Lockfiles (package-lock.json), next-env.d.ts, and .env.example templates
# are intentionally NOT ignored and must be committed.

# --- Dependencies (Node.js: Next.js frontend + Node backend scaffold) ---
node_modules/
.pnpm-store/
.yarn/
.npm/

# --- Build output ---
# .next/   (Next.js dev/build cache)
# out/     (Next.js static export)
# dist/    (Backend tsc outDir; also Vite-style output)
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Local environment & secrets ---
# Real local env files are ignored; checked-in templates stay tracked.
.env
.env.local
.env.*.local
!.env.example

# --- Logs & temporary files ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
.tmp-*

# --- Test coverage ---
coverage/

# --- Deployment / hosting local state ---
.vercel/

# --- Operating system ---
.DS_Store
Thumbs.db

# --- IDE local state (no shared .vscode/.idea config exists in this repo) ---
.vscode/
.idea/
*.swp
*~

# AI Agent configuration and workflow folders
/.agent/
/.ralphy/

# Documentation folders
/BACKEND/docs/
